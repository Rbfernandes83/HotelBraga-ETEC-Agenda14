<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelBraga.Views.HospedagemContratada"
             Title="Resumo da reserva" BackgroundColor="#F5F7FA">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Border BackgroundColor="#0B1D34" StrokeThickness="0" Padding="24,34">
                <Border.StrokeShape><RoundRectangle CornerRadius="0,0,28,28" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="HOTEL BRAGA" TextColor="#C6A15B" FontAttributes="Bold" FontSize="12" />
                    <Label Text="Resumo da sua estadia" FontSize="27" TextColor="White" FontAttributes="Bold" />
                    <Label Text="Confira os dados e o valor calculado." FontSize="13" TextColor="#D1DBE7" />
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout Padding="20,24" Spacing="16">
                <Border BackgroundColor="White" Stroke="#E4EAF1" StrokeThickness="1" Padding="20">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="ACOMODAÇÃO" FontSize="11" FontAttributes="Bold" TextColor="#B28B47" />
                        <Label x:Name="QuartoTexto" FontSize="22" FontAttributes="Bold" />
                        <BoxView HeightRequest="1" Color="#E4EAF1" />
                        <Label x:Name="HospedesTexto" FontSize="15" />
                        <Label x:Name="DatasTexto" FontSize="15" />
                        <Label x:Name="DiariasTexto" FontSize="15" />
                    </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="#EAF0F6" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="VALOR DA HOSPEDAGEM" FontSize="11" FontAttributes="Bold" TextColor="#617187" />
                        <Label x:Name="DescontoTexto" FontSize="13" TextColor="#47745D" />
                        <Label x:Name="TotalTexto" FontSize="30" FontAttributes="Bold" />
                        <Label Text="Simulação de valores para atividade acadêmica." FontSize="12" TextColor="#617187" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Voltar e editar reserva" Clicked="Voltar"
                        HeightRequest="54" CornerRadius="14" BackgroundColor="#142D4E" TextColor="White" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
