<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelBraga.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Azul">#142D4E</Color>
            <Color x:Key="AzulEscuro">#0B1D34</Color>
            <Color x:Key="Dourado">#C6A15B</Color>
            <Color x:Key="Fundo">#F5F7FA</Color>
            <Color x:Key="TextoSecundario">#617187</Color>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="TextColor" Value="#142D4E" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="#142D4E" />
                <Setter Property="TitleColor" Value="#617187" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="TextColor" Value="#142D4E" />
                <Setter Property="FontSize" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
